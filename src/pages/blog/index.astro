
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
---

<BaseLayout
  title="Roofing, Metal Siding & Building Tips | Oak Contracting LLC"
  description="Expert advice on metal siding, roofing, and building repairs from Oak Contracting LLC, serving Hutchinson and Central Kansas."
>
  <Header />

  <main class="blog-page">
    <div class="blog-container">
      <p class="eyebrow">OAK CONTRACTING LLC</p>
      <h1>From the Jobsite</h1>
      <p class="intro">
        Practical advice on metal roofing, siding, and
        building construction from our experience
        working on homes and buildings across Kansas.
      </p>

      <section class="articles">
        <h2>Featured Articles</h2>

        <article class="article-card">
          <p class="category">METAL EXTERIORS</p>
          <h3>
            Complete Metal Exteriors for New
            Construction Homes
          </h3>
          <p>
            See how textured metal roofing, siding,
            and architectural accents came together
            on our Haverhill project near Augusta, Kansas.
          </p>          
<a
  class="article-link"
  href="/blog/metal-siding-new-construction-kansas/"
>
  Read the Full Article →
</a>
        </article>
      </section>

      <section class="contact-box">
        <h2>Planning a Project?</h2>
        <p>
          Oak Contracting LLC specializes in complete
          metal exteriors, roofing, siding, and
          agricultural and commercial building repairs.
        </p>
        <a href="/#contact" class="contact-button">
          Request an Estimate
        </a>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .blog-page {
    background: #f6f6f4;
    color: #252525;
    min-height: 100vh;
    padding: 80px 20px;
  }

  .blog-container {
    max-width: 1050px;
    margin: auto;
  }

  .eyebrow, .category {
    color: #777;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  h1 {
    font-size: clamp(36px, 6vw, 58px);
    margin: 12px 0 20px;
  }

  .intro {
    font-size: 20px;
    line-height: 1.7;
    max-width: 750px;
  }

  .articles {
    margin-top: 65px;
  }

  .article-card {
    background: white;
    border: 1px solid #e1e1e1;
    border-radius: 8px;
    padding: 35px;
    margin-top: 25px;
  }

  .article-card h3 {
    font-size: 27px;
    line-height: 1.3;
    margin: 15px 0;
  }

  .article-card p {
    line-height: 1.7;
  }

  .coming-soon {
    display: inline-block;
    margin-top: 15px;
    color: #555;
    font-weight: 700;
  }

  .contact-box {
    margin-top: 65px;
    padding: 40px;
    background: #25262c;
    color: white;
    border-radius: 8px;
  }

  .contact-box p {
    line-height: 1.7;
  }

  .contact-button {
    display: inline-block;
    background: white;
    color: #222;
    padding: 13px 22px;
    margin-top: 15px;
    text-decoration: none;
    font-weight: 700;
    border-radius: 4px;
  }

  @media (max-width: 600px) {
    .blog-page {
      padding: 45px 18px;
    }

    .article-card, .contact-box {
      padding: 24px;
    }
  }
</style>
