  ---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
---
<BaseLayout
  title="Metal Roofing & Siding in Hutchinson, KS | Oak Contracting LLC"
  description="Oak Contracting LLC specializes in complete metal exteriors, metal roofing, siding and agricultural building repairs. Serving Hutchinson and Central Kansas."
>
  <Header />
  <main>
    <section class="hero" id="top">
    <img class="hero-photo" src="/assets/projects/homepage-cover.jpg" alt="Oak Contracting construction project" />
      <div class="hero-shade"></div>
      <div class="container hero-content">
        <p class="eyebrow">Serving Central Kansas</p>
        <h1>Built right.<br />Built to last.</h1>
        <p class="hero-lead">
          Agricultural and commercial building repair, metal roofing, siding,
          soffit, fascia, patio covers and practical construction solutions.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#contact">Request an Estimate</a>
          <a class="button secondary" href="tel:+16203143557">Call Arlin</a>
        </div>
        <div class="hero-proof">
          <span>Locally operated</span>
          <span>Direct communication</span>
          <span>Quality workmanship</span>
        </div>
      </div>
    </section>

    <section class="visual-strip">
      <div class="container visual-strip-grid">
        <div><strong>Agricultural</strong><span>Building repair</span></div>
        <div><strong>Commercial</strong><span>Exterior improvements</span></div>
        <div><strong>Metal Roofing</strong><span>Repair and replacement</span></div>
        <div><strong>Outdoor Living</strong><span>Patios and porches</span></div>
      </div>
    </section>

    <section class="section statement">
      <div class="container statement-grid">
        <div>
          <p class="eyebrow">Oak Contracting LLC</p>
          <h2>We solve building problems with practical, durable work.</h2>
        </div>
        <div>
          <p>
            From barns and commercial buildings to metal roofs, porches and exterior repairs,
            Oak Contracting focuses on clear communication, strong details and finished work
            that protects your property.
          </p>
          <a class="text-link" href="#projects">See the work →</a>
        </div>
      </div>
    </section>

    <section class="section services" id="services">
      <div class="container">
        <p class="eyebrow">Services</p>
        <h2>Work built for real-world use.</h2>

        <div class="service-grid">
          <article class="service-card">
            <img class="service-photo" src="/assets/projects/haverhill/WhatsApp%20Image%202026-11-02%20at%208.06.50%20PM%20%281%29.jpeg" alt="Standing seam metal roofing on Haverhill custom home" loading="lazy" />
            <div class="service-card-copy"><span>01</span><h3>Metal Roofing</h3><p>Reroofing, new metal roofing, repair work, flashing and trim details.</p></div>
          </article>

          <article class="service-card">
            <div class="service-photo stylized ag-visual"></div>
            <div class="service-card-copy"><span>02</span><h3>Agricultural Buildings</h3><p>Barns, machine sheds, shops, lean-tos, doors and weather-damaged components.</p></div>
          </article>

          <article class="service-card">
            <div class="service-photo stylized commercial-visual"></div>
            <div class="service-card-copy"><span>03</span><h3>Commercial Repair</h3><p>Exterior repairs and improvements that protect the building and daily operation.</p></div>
          </article>

          <article class="service-card">
            <img class="service-photo" src="/assets/projects/patio-after-thumb.webp" alt="Covered patio addition" loading="lazy" />
            <div class="service-card-copy"><span>04</span><h3>Patio Covers & Porches</h3><p>Covered patios, screened porches, decks, ramps and outdoor living additions.</p></div>
          </article>

          <article class="service-card">
            <img class="service-photo" src="/assets/projects/haverhill/WhatsApp%20Image%202026-11-02%20at%208.06.50%20PM%20%282%29.jpeg" alt="Textured black metal siding and soffit on Haverhill custom home" loading="lazy" />
            <div class="service-card-copy"><span>05</span><h3>Siding, Soffit & Fascia</h3><p>Durable exterior upgrades and clean roofline finishing details.</p></div>
          </article>

          <article class="service-card cta-card">
            <div class="service-card-copy">
              <p class="eyebrow">Different project?</p>
              <h3>Tell us what needs fixed.</h3>
              <p>Send a description and a few photos. We will let you know whether it fits our scope.</p>
              <a href="#contact">Start a conversation →</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="gallery-section" id="projects">
      <div class="gallery-grid">
        <figure class="gallery-large"><img src="/assets/projects/patio-after.webp" alt="Completed covered patio" loading="lazy" /><figcaption>Covered Patio Addition</figcaption></figure>
        <figure><img src="/assets/projects/porch-after.webp" alt="Completed screened porch" loading="lazy" /><figcaption>Screened Porch</figcaption></figure>
        <figure><img src="/assets/projects/patio-before.webp" alt="Exterior before patio addition" loading="lazy" /><figcaption>Before Construction</figcaption></figure>
      </div>
    </section>

    <section class="section about" id="about">
      <div class="container about-grid">
        <div class="about-mark">
          <img src="/assets/oak-logo-stacked-transparent.png" alt="Oak Contracting LLC logo" />
        </div>
        <div>
          <p class="eyebrow">Why Oak Contracting</p>
          <h2>Straightforward service and work that holds up.</h2>
          <p class="lead">Oak Contracting LLC serves farmers, business owners and property owners throughout Central Kansas.</p>
          <p>
            Led by Arlin Eicher, Oak Contracting brings hands-on construction experience,
            an agricultural background and an understanding of the value of your property.
          </p>
          <div class="check-grid">
            <span>Honest communication</span><span>Practical solutions</span><span>Respect for your property</span>
            <span>Central Kansas service</span><span>Clean finish details</span><span>Direct contact with Arlin</span>
          </div>
        </div>
      </div>
    </section>

    <section class="process">
      <div class="container">
        <p class="eyebrow">Our Process</p>
        <h2>Simple from first call to final walkthrough.</h2>
        <div class="process-grid">
          <article><span>1</span><h3>Call or Message</h3><p>Tell us what needs repaired or built.</p></article>
          <article><span>2</span><h3>Review the Project</h3><p>We discuss the scope and visit the site when needed.</p></article>
          <article><span>3</span><h3>Approve the Estimate</h3><p>You receive a clear written estimate before work begins.</p></article>
          <article><span>4</span><h3>Build It Right</h3><p>We complete the work and keep communication direct.</p></article>
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="container contact-grid">
        <div>
          <p class="eyebrow">Request an Estimate</p>
          <h2>Let’s talk about your project.</h2>
          <p>Share what needs repaired or improved. Basic measurements and photos are helpful when available.</p>
          <div class="contact-links">
            <a href="tel:+16203143557"><span>Phone</span><strong>(620) 314-3557</strong></a>
            <a href="mailto:arlin@oakcollco.com"><span>Email</span><strong>arlin@oakcollco.com</strong></a>
            <div><span>Service Area</span><strong>Central Kansas</strong></div>
          </div>
        </div>

        <form name="estimate-request" method="POST" enctype="multipart/form-data" data-netlify="true" netlify-honeypot="website" class="estimate-form">
          <input type="hidden" name="form-name" value="estimate-request" />
          <p class="hidden"><label>Leave empty: <input name="website" /></label></p>
          <div class="form-row">
            <label>Name<input type="text" name="name" required /></label>
            <label>Phone<input type="tel" name="phone" required /></label>
          </div>
          <label>Email<input type="email" name="email" /></label>
          <label>Project location<input type="text" name="location" placeholder="City or county" /></label>
          <label>Service needed
            <select name="service">
              <option>Agricultural building repair</option><option>Commercial building repair</option>
              <option>Metal roofing</option><option>Metal siding</option><option>Soffit and fascia</option>
              <option>Patio cover or porch</option><option>Other construction or repair</option>
            </select>
          </label>
          <label>Project details<textarea name="message" rows="5" required></textarea></label>
          <label>
            Project Photos (Optional)
          <input
          type="file"
          name="project-photo"
          accept="image/*"
        />
      </label>
      <p class="photo-help">
        A photo of the building or problem area helps us understand
        your project. For additional pictures or plans,
        email arlin@oakcollco.com.
      </p>
          <button class="button primary submit" type="submit">Send Estimate Request</button>
        </form>
      </div>
    </section>
  </main>

  <footer>
    <div class="container footer-grid">
      <img src="/assets/oak-logo-horizontal-transparent.png" alt="Oak Contracting LLC" />
      <p>Serving Central Kansas</p>
      <p>© <span id="year"></span> Oak Contracting LLC</p>
    </div>
  </footer>

  <script is:inline>
    document.getElementById("year").textContent = new Date().getFullYear();
    document.querySelectorAll("[data-slider]").forEach((slider) => {
      const input = slider.querySelector(".slider-range");
      const after = slider.querySelector(".slider-after-wrap");
      const handle = slider.querySelector(".slider-handle");
      const update = () => {
        const value = input.value;
        after.style.width = value + "%";
        handle.style.left = value + "%";
      };
      input.addEventListener("input", update);
      update();
    });
  </script>
</BaseLayout>
