---
import "../styles/global.css";
const {
  title = "Oak Contracting LLC",
  description = "Agricultural and commercial building repair, metal roofing, siding, soffit and fascia across Central Kansas."
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1f2027" />
    <link rel="icon" href="/assets/favicon.png" />
    <link rel="canonical" href={Astro.url} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
